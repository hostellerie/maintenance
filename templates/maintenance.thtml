<!DOCTYPE html>
<html lang="{language}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{maintenance_title}</title>
    <style>
        body { background:#f4f4f4; color:#333; font-family:Arial,sans-serif; margin:0; text-align:center; }
        .container { align-items:center; display:flex; flex-direction:column; justify-content:center; min-height:100vh; }
        .message-box { background:#fff; border:1px solid #ddd; border-radius:8px; box-shadow:0 2px 10px rgba(0,0,0,.1); max-width:600px; padding:40px; }
        h1 { color:#c00; font-size:28px; margin:0 0 15px; }
        p { font-size:16px; line-height:1.5; margin:0; }
        .icon { color:#c00; font-size:60px; margin-bottom:10px; }
        footer { color:#888; font-size:12px; margin-top:40px; }
        @media (max-width:480px) { .message-box { margin:0 10px; padding:25px; } h1 { font-size:22px; } }
    </style>
</head>
<body>
    <main class="container">
        <div class="message-box">
            <div class="icon" aria-hidden="true">&#9881;</div>
            <h1>{maintenance_title}</h1>
            <p>{maintenance_message}</p>
        </div>
        <footer>&copy; {current_year} {site_name} &mdash; {site_slogan}</footer>
    </main>
</body>
</html>
